{
  "name": "CommunityMessage",
  "type": "object",
  "properties": {
    "content": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "parent_id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "generale",
        "consigli",
        "alimentazione",
        "sintomi",
        "emotivo",
        "altro"
      ],
      "default": "generale"
    },
    "original_lang": {
      "type": "string",
      "description": "Codice lingua originale rilevato (ISO 639-1)"
    },
    "translated_text": {
      "type": "object",
      "description": "Cache {lang: text} delle traduzioni"
    },
    "mentions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "shared_entry": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "symptom",
            "meal",
            "med",
            "exam"
          ]
        },
        "id": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "content"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}