{
  "name": "MealTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "meal_type": {
      "type": "string",
      "enum": [
        "colazione",
        "pranzo",
        "cena",
        "spuntino"
      ]
    },
    "foods": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "foods"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}