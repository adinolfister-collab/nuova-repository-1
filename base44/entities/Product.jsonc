{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "nutrizione",
        "stomia",
        "comfort",
        "igiene",
        "farmaci",
        "integratori",
        "dispositivi",
        "cura_persona",
        "alimentazione_speciale"
      ]
    },
    "image_url": {
      "type": "string"
    },
    "amazon_url": {
      "type": "string",
      "description": "URL o ASIN del prodotto Amazon usato per costruire il deep link affiliato"
    },
    "query": {
      "type": "string",
      "description": "Termini di ricerca / ASIN usati come fallback per il link Amazon"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "number"
    }
  },
  "required": [
    "name",
    "category"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}